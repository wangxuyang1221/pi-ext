  "imageVectors": [
    {
      "test": "image_only_boundary_is_atomic_and_does_not_backfill_older_messages",
      "budget": 1845,
      "input": [
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "old"
            }
          ]
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_image",
              "image_url": "data:image/png;base64,abc"
            }
          ]
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "new"
            }
          ]
        }
      ],
      "expected": [
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_image",
              "image_url": "data:image/png;base64,abc"
            }
          ]
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "new"
            }
          ]
        }
      ]
    },
