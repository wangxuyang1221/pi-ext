{
  "name": "pi-ext",
  "version": "0.1.0",
  "description": "Goal, Codex compaction, Fast Mode, UI, subagent, MCP, and permissions extensions for Pi Coding Agent",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "license": "(MIT AND Apache-2.0)",
  "author": "Wang Xuyang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxuyang1221/pi-ext.git"
  },
  "bugs": {
    "url": "https://github.com/wangxuyang1221/pi-ext/issues"
  },
  "homepage": "https://github.com/wangxuyang1221/pi-ext#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "goal",
    "codex",
    "compaction",
    "openai",
    "fast-mode",
    "mcp",
    "permissions",
    "subagent",
    "tmux",
    "tui",
    "theme"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/codex-compact/dist",
    "extensions/codex-compact/LICENSE",
    "extensions/codex-compact/UPSTREAM.md",
    "extensions/openai-fast-mode/dist",
    "extensions/openai-fast-mode/LICENSE",
    "extensions/openai-fast-mode/UPSTREAM.md",
    "extensions/codex-ui/dist",
    "extensions/mcp/dist",
    "extensions/permissions/dist",
    "extensions/subagent/dist",
    "extensions/goal/dist",
    "extensions/goal/UPSTREAM.md",
    "extensions/goal/LICENSE",
    "extensions/goal/NOTICE",
    "docs/goal-descendant-acceptance.md",
    "docs/goal-ui-acceptance.md",
    "docs/goal-integration-acceptance.md",
    "docs/goal-storage-acceptance.md",
    "docs/goal-lifecycle-acceptance.md",
    "docs/goal-execution-report.md",
    "docs/goal-budget-acceptance.md",
    "themes/codex-pi.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/codex-compact/dist/index.js",
      "./extensions/openai-fast-mode/dist/index.js",
      "./extensions/permissions/dist/index.js",
      "./extensions/codex-ui/dist/index.js",
      "./extensions/mcp/dist/index.js",
      "./extensions/subagent/dist/index.js",
      "./extensions/goal/dist/index.js"
    ],
    "themes": [
      "./themes/codex-pi.json"
    ]
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p ./extensions/codex-compact/tsconfig.json && tsc -p ./extensions/openai-fast-mode/tsconfig.json && tsc -p ./extensions/codex-ui/tsconfig.json && tsc -p ./extensions/mcp/tsconfig.json && tsc -p ./extensions/permissions/tsconfig.json && tsc -p ./extensions/subagent/tsconfig.json && tsc -p ./extensions/goal/tsconfig.json",
    "typecheck": "tsc -p ./extensions/codex-compact/tsconfig.json --noEmit && tsc -p ./extensions/openai-fast-mode/tsconfig.json --noEmit && tsc -p ./extensions/codex-ui/tsconfig.json --noEmit && tsc -p ./extensions/mcp/tsconfig.json --noEmit && tsc -p ./extensions/permissions/tsconfig.json --noEmit && tsc -p ./extensions/subagent/tsconfig.json --noEmit && tsc -p ./extensions/goal/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run package:check",
    "package:check": "node ./scripts/check-package.mjs",
    "prototype:search-ui": "node ./prototypes/codex-search-ui-prototype/demo.mjs",
    "prototype:search-ui:check": "node ./prototypes/codex-search-ui-prototype/demo.mjs --smoke",
    "prototype:tui": "node ./prototypes/pi-tui-style-prototype/dev.mjs",
    "prototype:bash-ui": "node ./prototypes/codex-bash-ui-prototype/demo.mjs",
    "prototype:title-spinner": "node ./prototypes/codex-bash-ui-prototype/demo.mjs --title-spinner",
    "prototype:bash-ui:check": "node ./prototypes/codex-bash-ui-prototype/demo.mjs --smoke",
    "prototype:edit-spacing": "node ./prototypes/codex-edit-spacing-prototype/demo.mjs",
    "prototype:tool-summary": "node ./prototypes/codex-tool-summary-prototype/demo.mjs",
    "prototype:tool-summary:check": "node ./prototypes/codex-tool-summary-prototype/demo.mjs --smoke",
    "prototype:read-ui": "node ./prototypes/codex-read-ui-prototype/demo.mjs",
    "prototype:read-ui:check": "node ./prototypes/codex-read-ui-prototype/demo.mjs --smoke",
    "prototype:reasoning-ui": "node ./prototypes/codex-reasoning-ui-prototype/demo.mjs",
    "prototype:reasoning-ui:check": "node ./prototypes/codex-reasoning-ui-prototype/demo.mjs --smoke",
    "prototype:subagent-ui": "node ./prototypes/subagent-tool-ui-prototype/demo.mjs",
    "prototype:compact-notice": "node ./prototypes/codex-compact-notice-prototype/demo.mjs",
    "prototype:mcp-ui": "node ./prototypes/mcp-status-ui-prototype/demo.mjs",
    "prototype:mcp-ui:check": "pnpm exec tsc -p ./prototypes/mcp-status-ui-prototype/tsconfig.json && pnpm exec vitest run extensions/mcp/__tests__/status-ui-prototype.test.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "jsonc-parser": "^3.3.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
